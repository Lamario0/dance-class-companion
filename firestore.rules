rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Community chat (services/chatService.ts).
    // Anyone can read and post. Nobody can edit or delete from a browser:
    // instructors do that through /api/chat-moderate (Admin SDK bypasses rules).
    // Old quarters are removed by a TTL policy on `expireAt`.
    match /chatMessages/{messageId} {
      allow read: if true;

      allow create: if isValidMessage(request.resource.data);
      allow update, delete: if false;

      function isValidMessage(m) {
        return m.keys().hasOnly(['author', 'text', 'parentId', 'quarter', 'createdAt', 'expireAt'])
          && m.keys().hasAll(['author', 'text', 'parentId', 'quarter', 'createdAt', 'expireAt'])
          && m.author is string && m.author.trim().size() > 0 && m.author.size() <= 40
          // "Studio Admin" is reserved for instructor posts
          && m.author.trim().lower() != 'studio admin'
          && m.text is string && m.text.trim().size() > 0 && m.text.size() <= 1000
          && (m.parentId == null
              || (m.parentId is string
                  && exists(/databases/$(database)/documents/chatMessages/$(m.parentId))))
          && m.quarter is string && m.quarter.matches('^[0-9]{4}-Q[1-4]$')
          && m.createdAt == request.time
          // expires at the start of next quarter: always in the future, never more than ~3 months out
          && m.expireAt is timestamp
          && m.expireAt > request.time
          && m.expireAt <= request.time + duration.value(93, 'd');
      }
    }

    // Student profiles (services/authService.ts). Private to their owner.
    // Roles are Firebase custom claims, never fields here, so nobody can
    // promote themselves. Deleting happens server-side (/api/delete-account).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'createdAt'])
        && isValidName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && isValidName(request.resource.data.displayName);

      allow delete: if false;

      function isValidName(n) {
        return n is string && n.trim().size() > 0 && n.size() <= 40;
      }

      // Personal notes (services/notesService.ts). Owner only, verified email only
      // (Google sign-ins are verified). Account deletion removes them server-side.
      match /notes/{noteId} {
        allow read, delete: if isVerifiedOwner();

        allow create: if isVerifiedOwner()
          && request.resource.data.keys().hasOnly(['kind', 'classKey', 'className', 'pattern', 'weekOf', 'title', 'body', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['kind', 'classKey', 'className', 'pattern', 'weekOf', 'title', 'body', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['class', 'free']
          && isText(request.resource.data.classKey, 60)
          && isText(request.resource.data.className, 100)
          && isText(request.resource.data.pattern, 300)
          && isText(request.resource.data.weekOf, 10)
          && isText(request.resource.data.title, 80)
          && isText(request.resource.data.body, 10000)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          // class notes: id is "<classKey>__<weekOf>", so one entry per class per week
          && (request.resource.data.kind == 'free'
              || (request.resource.data.weekOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                  && request.resource.data.classKey.size() > 0
                  && noteId == request.resource.data.classKey + '__' + request.resource.data.weekOf));

        allow update: if isVerifiedOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'updatedAt'])
          && isText(request.resource.data.title, 80)
          && isText(request.resource.data.body, 10000)
          && request.resource.data.updatedAt == request.time;

        function isVerifiedOwner() {
          return request.auth != null && request.auth.uid == uid
            && request.auth.token.email_verified == true;
        }
        function isText(v, max) {
          return v is string && v.size() <= max;
        }
      }
    }

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
