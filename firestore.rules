rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Community chat (services/chatService.ts). Anyone can read.
    // - Guests (and unverified accounts) post under any name; nobody but an admin
    //   can change their messages afterwards.
    // - Members (verified accounts) post with their uid under their profile name,
    //   and can edit, soft-delete or delete their own messages.
    // - Admins (custom claim, never a stored field) can edit or delete any message.
    // Deleted accounts' messages are relabelled server-side (/api/delete-account).
    // Old quarters are removed by a TTL policy on `expireAt`.
    match /chatMessages/{messageId} {
      allow read: if true;

      allow create: if isValidBase(request.resource.data)
        && (isGuestPost(request.resource.data) || isMemberPost(request.resource.data));

      // Owners: edit text, soft-delete, or follow a rename. Admins: edit or soft-delete anything.
      allow update: if (isOwner() && (isTextEdit() || isSoftDelete() || isRename()))
        || (isAdmin() && (isTextEdit() || isSoftDelete()));

      allow delete: if isOwner() || isAdmin();

      function verified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }
      function isAdmin() {
        return verified() && request.auth.token.get('admin', false) == true;
      }
      function isOwner() {
        return verified() && resource.data.get('uid', null) == request.auth.uid;
      }
      function profileName() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName;
      }
      function validText(t) {
        return t is string && t.trim().size() > 0 && t.size() <= 1000;
      }

      function isValidBase(m) {
        return m.keys().hasAll(['author', 'text', 'parentId', 'quarter', 'createdAt', 'expireAt'])
          && m.author is string && m.author.trim().size() > 0 && m.author.size() <= 40
          // "Studio Admin" is reserved
          && m.author.trim().lower() != 'studio admin'
          && validText(m.text)
          && (m.parentId == null
              || (m.parentId is string
                  && exists(/databases/$(database)/documents/chatMessages/$(m.parentId))))
          && m.quarter is string && m.quarter.matches('^[0-9]{4}-Q[1-4]$')
          && m.createdAt == request.time
          // expires at the start of next quarter: always in the future, never more than ~3 months out
          && m.expireAt is timestamp
          && m.expireAt > request.time
          && m.expireAt <= request.time + duration.value(93, 'd');
      }
      function isGuestPost(m) {
        return m.keys().hasOnly(['author', 'text', 'parentId', 'quarter', 'createdAt', 'expireAt']);
      }
      function isMemberPost(m) {
        return verified()
          && m.keys().hasOnly(['author', 'text', 'parentId', 'quarter', 'createdAt', 'expireAt', 'uid', 'role'])
          && m.uid == request.auth.uid
          && m.author == profileName()
          // the admin tag only for real admins, and every admin post carries it
          && m.role in ['member', 'admin']
          && (m.role == 'admin') == (request.auth.token.get('admin', false) == true);
      }

      function isTextEdit() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && validText(request.resource.data.text)
          && request.resource.data.editedAt == request.time
          && resource.data.get('deleted', false) == false;
      }
      function isSoftDelete() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted', 'editedAt'])
          && request.resource.data.deleted == true
          && request.resource.data.text == ''
          && request.resource.data.editedAt == request.time;
      }
      function isRename() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['author'])
          && request.resource.data.author == profileName();
      }
    }

    // Student profiles (services/authService.ts). Private to their owner.
    // Roles are Firebase custom claims, never fields here, so nobody can
    // promote themselves. Deleting happens server-side (/api/delete-account).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'createdAt'])
        && isValidName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && isValidName(request.resource.data.displayName);

      allow delete: if false;

      function isValidName(n) {
        return n is string && n.trim().size() > 0 && n.size() <= 40;
      }

      // Personal notes (services/notesService.ts). Owner only, verified email only
      // (Google sign-ins are verified). Account deletion removes them server-side.
      match /notes/{noteId} {
        allow read, delete: if isVerifiedOwner();

        allow create: if isVerifiedOwner()
          && request.resource.data.keys().hasOnly(['kind', 'classKey', 'className', 'pattern', 'weekOf', 'title', 'body', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['kind', 'classKey', 'className', 'pattern', 'weekOf', 'title', 'body', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['class', 'free']
          && isText(request.resource.data.classKey, 60)
          && isText(request.resource.data.className, 100)
          && isText(request.resource.data.pattern, 300)
          && isText(request.resource.data.weekOf, 10)
          && isText(request.resource.data.title, 80)
          && isText(request.resource.data.body, 10000)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          // class notes: id is "<classKey>__<weekOf>", so one entry per class per week
          && ((request.resource.data.kind == 'free'
               // free notes can't take a class-note id and block that week's class note
               && !noteId.matches('^.*__[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
              || (request.resource.data.weekOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                  && request.resource.data.classKey.size() > 0
                  && noteId == request.resource.data.classKey + '__' + request.resource.data.weekOf));

        // Edits change title/body. A device that was offline may also re-create a
        // class note another device already made: accept that as an overwrite as
        // long as it's the same note (kind, class, week unchanged), so the
        // student's text isn't silently dropped on sync.
        allow update: if isVerifiedOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'updatedAt', 'pattern', 'createdAt'])
          && isText(request.resource.data.title, 80)
          && isText(request.resource.data.body, 10000)
          && isText(request.resource.data.pattern, 300)
          && (request.resource.data.createdAt == resource.data.createdAt || request.resource.data.createdAt == request.time)
          && request.resource.data.updatedAt == request.time;

        function isVerifiedOwner() {
          return request.auth != null && request.auth.uid == uid
            && request.auth.token.email_verified == true;
        }
        function isText(v, max) {
          return v is string && v.size() <= max;
        }
      }
    }

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
